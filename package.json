{
  "name": "ai-interview-questions-mcp",
  "version": "1.1.0",
  "description": "MCP server with 200 graded interview questions and model answers: 100 AI Engineer (LLMs, RAG, agents, evals, system design) and 100 Investment Banking (accounting, valuation, M&A, LBO). Offline over stdio, or hosted over Streamable HTTP. No API keys.",
  "type": "module",
  "bin": {
    "ai-interview-questions-mcp": "build/index.js"
  },
  "main": "build/index.js",
  "files": [
    "build",
    "data",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js',0o755)\"",
    "start": "node build/index.js",
    "test": "node test/smoke.mjs && node test/http.mjs",
    "prepublishOnly": "npm run build && npm test",
    "build:data": "python3 scripts/build_data.py ../ai-engineer-interview-questions",
    "start:http": "node build/http.js"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "interview",
    "interview-prep",
    "interview-questions",
    "ai-engineer",
    "llm",
    "rag",
    "ai-agents",
    "mock-interview",
    "career",
    "investment-banking",
    "finance-interview",
    "streamable-http"
  ],
  "author": "Valenx Press <press@valenx.org>",
  "license": "MIT",
  "homepage": "https://github.com/Johnnnmai/ai-interview-questions-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Johnnnmai/ai-interview-questions-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Johnnnmai/ai-interview-questions-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "mcpName": "io.github.Johnnnmai/ai-interview-questions-mcp",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
