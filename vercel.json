{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "installCommand": "npm ci --omit=dev",
  "outputDirectory": "public",
  "functions": {
    "api/mcp.js": {
      "includeFiles": "{build,data}/**",
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    }
  ]
}
